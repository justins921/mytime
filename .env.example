# Database - SQLite for local dev, Neon Postgres for production
# Local dev (SQLite):
DATABASE_URL="file:./dev.db"

# Production (Neon Postgres) - uncomment for production:
# DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/mytime?sslmode=require"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# Only this email can log in (single-user mode)
ALLOWED_EMAIL="you@example.com"

# Resend (for support ticket email notifications)
RESEND_API_KEY="re_xxxxxxxxxxxx"

# App URL
NEXTAUTH_URL="http://localhost:3000"

# Stripe (required for paid plans)
STRIPE_SECRET_KEY="sk_live_or_sk_test_xxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxx"
# Create these prices in your Stripe dashboard (Products → Add product → Add price)
STRIPE_PRICE_PRO_MONTHLY="price_xxxxxxxxxxxx"
STRIPE_PRICE_PRO_ANNUAL="price_xxxxxxxxxxxx"
STRIPE_PRICE_BUSINESS_MONTHLY="price_xxxxxxxxxxxx"
STRIPE_PRICE_BUSINESS_ANNUAL="price_xxxxxxxxxxxx"

# Slack Integration
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""

# Gmail Integration (Google OAuth)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Outlook Integration (Microsoft OAuth)
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# Notion Integration (Public OAuth)
NOTION_CLIENT_ID=""
NOTION_CLIENT_SECRET=""

# ClickUp Integration (OAuth)
CLICKUP_CLIENT_ID=""
CLICKUP_CLIENT_SECRET=""

# Asana Integration (OAuth)
ASANA_CLIENT_ID=""
ASANA_CLIENT_SECRET=""

# Monday.com Integration (OAuth)
MONDAY_CLIENT_ID=""
MONDAY_CLIENT_SECRET=""

# Trello Integration (Authorize redirect)
TRELLO_API_KEY=""

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_CLARITY_TRACKING_ID="xxxxxxxxxx"

# Admin
ADMIN_EMAIL="you@example.com"
