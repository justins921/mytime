generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth.js models ──────────────────────────────────────
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String?
  emailVerified DateTime?
  image         String?

  // Stripe
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?
  plan                 String    @default("free") // free | starter | pro | business
  planExpiresAt        DateTime?

  // Role: admin | manager | user
  role                 String    @default("user")

  accounts      Account[]
  sessions      Session[]
  clients       Client[]
  settings      Settings?
  timeOff       TimeOff[]
  calendarFeeds CalendarFeed[]
  notes         Note[]
  floatingTasks FloatingTask[]
  scheduleBlocks ScheduleBlock[]
  timeEntries   TimeEntry[]
  slackWorkspaces  SlackWorkspace[]
  gmailAccounts    GmailAccount[]
  notionWorkspaces NotionWorkspace[]
  outlookAccounts  OutlookAccount[]
  triageDismissals TriageDismissal[]
  supportTickets   SupportTicket[]
  crmContacts      CRMContact[]
  crmActivities    CRMActivity[]
  contractTemplates ContractTemplate[]
  contracts         Contract[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── App models ──────────────────────────────────────────
model Client {
  id                    String          @id @default(cuid())
  userId                String
  name                  String
  retainerMonthly       Float           @default(2000)
  baselineRateHourly    Float           @default(50)
  weeklyTargetHours     Float           @default(10)
  monthlyCapHours       Float           @default(40)
  priorityWeight        Float           @default(1.0)
  style                 String          @default("DeepWork") // DeepWork | Support | Mixed | Personal
  dailyTouch            Boolean         @default(false)
  isPersonal            Boolean         @default(false)
  color                 String          @default("#3b82f6")
  sortOrder             Int             @default(0)
  archived              Boolean         @default(false)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects              Project[]
  scheduleBlocks        ScheduleBlock[]
  timeEntries           TimeEntry[]
  slackWorkspaces       SlackWorkspace[]
  gmailAccounts         GmailAccount[]
  outlookAccounts       OutlookAccount[]
  floatingTasks         FloatingTask[]
  notes                 Note[]

  @@index([userId])
}

model Project {
  id             String          @id @default(cuid())
  clientId       String
  name           String
  tags           String          @default("") // comma-separated: "UC30", etc.
  weight         Float           @default(1.0)
  archived       Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  client         Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tasks          Task[]
  scheduleBlocks ScheduleBlock[]
  timeEntries    TimeEntry[]
  floatingTasks  FloatingTask[]
}

model Task {
  id              String      @id @default(cuid())
  projectId       String
  title           String
  description     String      @default("")
  priority        String      @default("P2") // P1 | P2 | P3
  estimateMinutes Int?
  dueDate         DateTime?
  status          String      @default("Backlog") // Backlog | InProgress | Done
  url             String      @default("")
  tags            String      @default("") // comma-separated
  sortOrder       Int         @default(0)
  clickupTaskId   String?     @unique // ClickUp task ID if imported from triage
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  project         Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  timeEntries     TimeEntry[]
}

model ScheduleBlock {
  id          String      @id @default(cuid())
  userId      String
  date        String      // YYYY-MM-DD
  startTime   String      // HH:mm
  endTime     String      // HH:mm
  clientId    String?
  projectId   String?
  title       String
  type        String      // Support | DeepWork | Break | Admin | Lunch
  locked      Boolean     @default(false)
  generated   Boolean     @default(true)
  notes       String      @default("")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  client      Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project     Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  timeEntries TimeEntry[]

  @@index([userId])
}

model TimeEntry {
  id              String         @id @default(cuid())
  userId          String
  startAt         DateTime
  endAt           DateTime?
  durationMinutes Float?
  clientId        String
  projectId       String?
  taskId          String?
  scheduleBlockId String?
  notes           String         @default("")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  client          Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task            Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  scheduleBlock   ScheduleBlock? @relation(fields: [scheduleBlockId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model TriageDismissal {
  id            String   @id @default(cuid())
  userId        String
  clickupTaskId String   // also used for trello/asana/monday task IDs
  source        String   @default("clickup") // clickup | trello | asana | monday
  action        String   // "dismissed" | "ignored" | "deleted" | "added"
  notes         String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clickupTaskId])
}

model SlackWorkspace {
  id          String   @id @default(cuid())
  userId      String
  teamId      String
  teamName    String
  accessToken String
  scope       String   @default("")
  clientId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@unique([userId, teamId])
}

model GmailAccount {
  id           String      @id @default(cuid())
  userId       String
  email        String
  accessToken  String
  refreshToken String
  expiresAt    Int?        // Unix timestamp (seconds)
  scope        String      @default("")
  clientId     String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  client       Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  emailCards   EmailCard[]

  @@unique([userId, email])
}

model EmailCard {
  id             String       @id @default(cuid())
  gmailMessageId String
  accountId      String
  subject        String       @default("")
  fromAddress    String       @default("")
  snippet        String       @default("")
  receivedAt     DateTime?
  status         String       @default("Todo") // Todo | InProgress | Done
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  account        GmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([gmailMessageId, accountId])
}

model OutlookAccount {
  id           String   @id @default(cuid())
  userId       String
  email        String
  accessToken  String
  refreshToken String
  expiresAt    Int?     // Unix timestamp (seconds)
  scope        String   @default("")
  clientId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  client       Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@unique([userId, email])
}

model TimeOff {
  id        String   @id @default(cuid())
  userId    String
  startDate String   // YYYY-MM-DD
  endDate   String   // YYYY-MM-DD (inclusive)
  title     String
  type      String   @default("Vacation") // Vacation | SickDay | Holiday | Personal
  allDay    Boolean  @default(true)
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model FloatingTask {
  id              String    @id @default(cuid())
  userId          String
  title           String
  estimateMinutes Int       @default(60)
  clientId        String?
  projectId       String?
  dueDate         String?   // YYYY-MM-DD — schedule by this date
  priority        String    @default("P2") // P1 | P2 | P3
  mustSchedule    Boolean   @default(true)  // locked in — must be done this week
  status          String    @default("pending") // pending | scheduled | completed
  scheduleBlockId String?   // link to generated block when scheduled
  notes           String    @default("")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  client          Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project         Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model CalendarFeed {
  id            String    @id @default(cuid())
  userId        String
  name          String    // "Work Calendar", "Personal", etc.
  url           String    // ICS/CalDAV feed URL
  color         String    @default("#8b5cf6")
  enabled       Boolean   @default(true)
  lastSync      DateTime?
  lastSyncError String    @default("")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("Untitled")
  content   String   @default("") // rich text / markdown
  clientId  String?
  pinned    Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model NotionWorkspace {
  id            String              @id @default(cuid())
  userId        String
  workspaceId   String
  workspaceName String
  accessToken   String
  botId         String              @default("")
  icon          String              @default("")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  favoritePages NotionFavoritePage[]

  @@unique([userId, workspaceId])
}

model NotionFavoritePage {
  id          String           @id @default(cuid())
  pageId      String           // Notion page ID
  title       String
  icon        String           @default("")
  workspaceId String
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  workspace   NotionWorkspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([pageId, workspaceId])
}

model Settings {
  id                    String   @id @default(cuid())
  userId                String   @unique
  timezone              String   @default("America/Chicago")
  // Availability: JSON string of per-day config
  // Format: {"mon":{"start":"09:00","end":"15:30","enabled":true},...}
  availabilityJson      String   @default("{\"mon\":{\"start\":\"09:00\",\"end\":\"15:30\",\"enabled\":true},\"tue\":{\"start\":\"09:00\",\"end\":\"15:30\",\"enabled\":true},\"wed\":{\"start\":\"09:00\",\"end\":\"15:30\",\"enabled\":true},\"thu\":{\"start\":\"09:00\",\"end\":\"15:30\",\"enabled\":true},\"fri\":{\"start\":\"09:00\",\"end\":\"15:30\",\"enabled\":true},\"sat\":{\"start\":\"09:00\",\"end\":\"15:30\",\"enabled\":false},\"sun\":{\"start\":\"09:00\",\"end\":\"15:30\",\"enabled\":false}}")
  // Fixed breaks JSON: [{"start":"10:15","end":"10:45","title":"Pickup","locked":true}]
  fixedBreaksJson       String   @default("[{\"start\":\"10:15\",\"end\":\"10:45\",\"title\":\"School Pickup\",\"locked\":true}]")
  // Lunch reserve JSON: {"start":"12:45","end":"13:15","title":"Lunch"}
  lunchReserveJson      String   @default("{\"start\":\"12:45\",\"end\":\"13:15\",\"title\":\"Lunch\"}")
  // Night work per day: {"mon":{"enabled":false,"start":"20:00","end":"22:00"},...}
  nightWorkJson         String   @default("{\"mon\":{\"enabled\":false,\"start\":\"20:00\",\"end\":\"22:00\"},\"tue\":{\"enabled\":false,\"start\":\"20:00\",\"end\":\"22:00\"},\"wed\":{\"enabled\":false,\"start\":\"20:00\",\"end\":\"22:00\"},\"thu\":{\"enabled\":false,\"start\":\"20:00\",\"end\":\"22:00\"},\"fri\":{\"enabled\":false,\"start\":\"20:00\",\"end\":\"22:00\"},\"sat\":{\"enabled\":false,\"start\":\"20:00\",\"end\":\"22:00\"},\"sun\":{\"enabled\":false,\"start\":\"20:00\",\"end\":\"22:00\"}}")
  // Deep work split JSON: {"splits":[{"clientId":"...","weight":70},{"clientId":"...","weight":30}]}
  deepWorkSplitJson     String   @default("{\"splits\":[]}")
  supportSweepMinutes   Int      @default(30)
  generateFromNow       Boolean  @default(false)
  uc30WeeklyHours       Float    @default(0)
  // ClickUp integration
  clickupApiToken       String   @default("")
  // Maps ClickUp workspace (team) IDs to MyTime client IDs: {"teamId":"clientId",...}
  clickupWorkspaceMapJson String  @default("{}")
  // Trello integration
  trelloApiToken        String   @default("")
  trelloWorkspaceMapJson String  @default("{}")
  // Asana integration
  asanaApiToken         String   @default("")
  asanaWorkspaceMapJson String   @default("{}")
  // Monday.com integration
  mondayApiToken        String   @default("")
  mondayWorkspaceMapJson String  @default("{}")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Support ──────────────────────────────────────────
model SupportTicket {
  id          String   @id @default(cuid())
  userId      String
  type        String   // "bug" | "feature" | "integration" | "feedback" | "testimonial" | "support"
  subject     String
  message     String
  status      String   @default("open") // open | in_progress | resolved | closed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Knowledge Base ──────────────────────────────────
model KnowledgeBaseArticle {
  id                String   @id @default(cuid())
  title             String
  slug              String   @unique
  content           String   // Markdown content
  category          String   // "getting-started" | "integrations" | "billing" | "features" | "troubleshooting"
  tags              String   @default("") // comma-separated
  relatedTicketTypes String  @default("") // comma-separated: "bug,support"
  status            String   @default("draft") // draft | published
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ─── Landing Page CMS ────────────────────────────────
model LandingPageSection {
  id        String   @id @default(cuid())
  section   String   @unique // hero | metrics | problems | beforeAfter | features | howItWorks | integrations | comparison | pricing | calculator | faq | finalCta
  content   String   @db.Text // JSON blob with section-specific fields
  updatedAt DateTime @updatedAt
}

// ─── CRM ─────────────────────────────────────────────
model CRMContact {
  id              String        @id @default(cuid())
  userId          String
  name            String
  email           String        @default("")
  phone           String        @default("")
  company         String        @default("")
  website         String        @default("")
  stage           String        @default("lead") // lead | contacted | meeting | proposal | won | lost
  source          String        @default("other") // referral | website | linkedin | cold_outreach | event | other
  estimatedValue  Float         @default(0) // potential deal value
  notes           String        @default("")
  linkedClientId  String?       // optional link to an existing Client once won
  lastContactedAt DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities      CRMActivity[]
  contracts       Contract[]

  @@index([userId])
}

model CRMActivity {
  id          String     @id @default(cuid())
  userId      String
  contactId   String
  type        String     // email | call | meeting | note | follow_up | proposal
  title       String
  description String     @default("")
  date        DateTime   @default(now())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact     CRMContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([contactId])
}

// ─── Contract Templates & Contracts ─────────────────
model ContractTemplate {
  id        String   @id @default(cuid())
  userId    String
  name      String
  content   String   @db.Text // Markdown with {{merge_fields}}
  isDefault Boolean  @default(false) // built-in starter templates
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contracts Contract[]

  @@index([userId])
}

model Contract {
  id         String    @id @default(cuid())
  userId     String
  contactId  String
  templateId String?
  name       String
  content    String    @db.Text // rendered Markdown (merge fields resolved)
  status     String    @default("draft") // draft | sent | signed
  sentAt     DateTime?
  signedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact    CRMContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  template   ContractTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([contactId])
}
